{% extends 'base.html.twig' %}

{% block title %}Photo index{% endblock %}

{% block body %}
    <h1>Photo index</h1>

    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>DatePriseVue</th>
                <th>NomFichier</th>
                <th>EtatOeuvre</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for photo in photos %}
            <tr>
                <td>{{ photo.id }}</td>
                <td>{{ photo.datePriseVue ? photo.datePriseVue|date('Y-m-d H:i:s') : '' }}</td>
                <td><img src="{{ asset('uploads/photos/' ~ photo.nomFichier) }}" alt="" class="img-thumbnail" style="height: 80px"></td>
                <td>{{ photo.etatOeuvre }}</td>
                <td>
                    <a class="btn btn-sm btn-info" href="{{ path('app_photo_show', {'id': photo.id}) }}">Voir</a>
                    <a class="btn btn-sm btn-warning" href="{{ path('app_photo_edit', {'id': photo.id}) }}">Modifier</a>
                    {{ include('photo/_delete_form.html.twig') }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a class="btn btn-primary" href="{{ path('app_photo_new') }}">Ajouter</a>
{% endblock %}
