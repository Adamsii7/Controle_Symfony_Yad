{% extends 'base.html.twig' %}

{% block title %}Benevole index{% endblock %}

{% block body %}
    <h1>Benevole index</h1>

    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Prenom</th>
                <th>Email</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for benevole in benevoles %}
            <tr>
                <td>{{ benevole.id }}</td>
                <td>{{ benevole.nom }}</td>
                <td>{{ benevole.prenom }}</td>
                <td>{{ benevole.email }}</td>
                <td>
                    <a class="btn btn-sm btn-info" href="{{ path('app_benevole_show', {'id': benevole.id}) }}">Voir</a>
                    <a class="btn btn-sm btn-warning" href="{{ path('app_benevole_edit', {'id': benevole.id}) }}">Modifier</a>
                    {{ include('benevole/_delete_form.html.twig') }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a class="btn btn-primary" href="{{ path('app_benevole_new') }}">Ajouter</a>
{% endblock %}
