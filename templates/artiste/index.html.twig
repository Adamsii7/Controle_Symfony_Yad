{% extends 'base.html.twig' %}

{% block title %}Artiste index{% endblock %}

{% block body %}
    <h1>Artiste index</h1>

    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>Pseudonyme</th>
                <th>NomReel</th>
                <th>Bio</th>
                <th>Nationalite</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for artiste in artistes %}
            <tr>
                <td>{{ artiste.id }}</td>
                <td>{{ artiste.pseudonyme }}</td>
                <td>{{ artiste.nomReel }}</td>
                <td>{{ artiste.bio }}</td>
                <td>{{ artiste.nationalite }}</td>
                <td>
                    <a class="btn btn-sm btn-info" href="{{ path('app_artiste_show', {'id': artiste.id}) }}">Voir</a>
                    <a class="btn btn-sm btn-warning" href="{{ path('app_artiste_edit', {'id': artiste.id}) }}">Modifier</a>
                    {{ include('artiste/_delete_form.html.twig') }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a class="btn btn-primary" href="{{ path('app_artiste_new') }}">Ajouter</a>
{% endblock %}
