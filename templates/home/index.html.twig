{% extends 'base.html.twig' %}

{% block title %}Art-2-Rue{% endblock %}

{% block body %}
<h1 class="mb-1">Art-2-Rue</h1>
<p class="text-muted mb-4">Archivage du patrimoine éphémère du Street Art</p>

<div class="row g-3">
    {% set sections = [
        {'label': 'Œuvres', 'route': 'app_oeuvre_index', 'desc': 'Les œuvres archivées'},
        {'label': 'Artistes', 'route': 'app_artiste_index', 'desc': 'Les artistes et leur bio'},
        {'label': 'Lieux', 'route': 'app_lieu_index', 'desc': 'Où se trouvent les œuvres'},
        {'label': 'Techniques', 'route': 'app_technique_index', 'desc': 'Pochoir, collage, mosaïque…'},
        {'label': 'Bénévoles', 'route': 'app_benevole_index', 'desc': 'Les photographes'},
        {'label': 'Photos', 'route': 'app_photo_index', 'desc': 'Suivi de l\'évolution des œuvres'}
    ] %}
    {% for s in sections %}
        <div class="col-md-4">
            <a href="{{ path(s.route) }}" class="card h-100 text-decoration-none">
                <div class="card-body">
                    <h5 class="card-title">{{ s.label }}</h5>
                    <p class="card-text text-muted mb-0">{{ s.desc }}</p>
                </div>
            </a>
        </div>
    {% endfor %}
</div>
{% endblock %}
